generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  firstName        String?
  lastName         String?
  region           String?
  isEmailVerified  Boolean     @default(false)
  verificationToken String?
  role             String      @default("USER")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  courses      Course[]
  crosswords   Crossword[]
  games        Game[]
  media        Media[]
  progress          Progress[]
  stories           Story[]
  simulationHearts  SimulationHearts?

  @@map("users")
}

model SimulationHearts {
  userId    String   @id
  losses    String   @default("[]")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("simulation_hearts")
}

model Course {
  id          String     @id @default(cuid())
  title       String
  description String
  content     String
  level       String
  imagePath   String?
  videoUrl    String?
  order       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  pdfPath     String?
  createdBy   User       @relation(fields: [userId], references: [id])
  progress    Progress[]

  @@map("courses")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("in-progress")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("progress")
}

model Game {
  id          String    @id @default(cuid())
  type        String
  mode        String
  title       String
  description String?
  difficulty  String    @default("medium")
  isActive    Boolean   @default(true)
  userId      String
  status      String    @default("locked")
  score       Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  metadata    String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("games")
}

model MediaCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  media       Media[]

  @@map("media_categories")
}

model Media {
  id            String        @id @default(cuid())
  title         String
  description   String
  type          String
  language      String        @default("Allemand")
  languageLevel String        @default("A1")
  subtitles     String?
  duration      String?
  rating        Float?
  viewers       String?
  imageUrl      String?
  mediaFileUrl  String?
  streamingUrl  String?
  platform      String?
  director      String?
  cast          String?
  year          Int?
  genre         String?
  season        Int?
  episodes      Int?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  categoryId    String
  userId        String
  createdBy     User          @relation(fields: [userId], references: [id])
  category      MediaCategory @relation(fields: [categoryId], references: [id])

  @@map("media")
}

model Crossword {
  id          String           @id @default(cuid())
  title       String
  description String?
  width       Int              @default(15)
  height      Int              @default(15)
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      String
  entries     CrosswordEntry[]
  createdBy   User             @relation(fields: [userId], references: [id])

  @@map("crosswords")
}

model CrosswordEntry {
  id          String    @id @default(cuid())
  crosswordId String
  row         Int
  col         Int
  direction   String
  clue        String
  answer      String
  number      Int
  crossword   Crossword @relation(fields: [crosswordId], references: [id], onDelete: Cascade)

  @@index([crosswordId])
  @@map("crossword_entries")
}

model Story {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          String
  content       String?
  imageUrl      String?
  pdfUrl        String?
  audioUrl      String?
  language      String   @default("Allemand")
  languageLevel String   @default("A1")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  createdBy     User     @relation(fields: [userId], references: [id])

  @@map("stories")
}

model GermanBingoClass {
  id        String                 @id @default(cuid())
  label     String
  imagePath String?
  icon      String?
  english   String?
  createdAt DateTime               @default(now())
  words     GermanBingoWordClass[]

  @@map("german_bingo_classes")
}

model GermanBingoWord {
  id        String                 @id @default(cuid())
  word      String
  english   String?
  emoji     String?
  createdAt DateTime               @default(now())
  classes   GermanBingoWordClass[]

  @@map("german_bingo_words")
}

model GermanBingoWordClass {
  wordId  String
  classId String
  word    GermanBingoWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  class   GermanBingoClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([wordId, classId])
  @@map("german_bingo_word_classes")
}

model ShadowingVideo {
  id             String            @id @default(cuid())
  youtubeId      String            @unique
  youtubeUrl     String
  title          String?
  durationSec    Int?
  segmentsJson   String
  fullText       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       ShadowingSession[]

  @@map("shadowing_videos")
}

model ShadowingSession {
  id              String         @id @default(cuid())
  userId          String
  videoId         String
  currentIndex    Int            @default(0)
  quizJson        String?
  quizScore       Int?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  video           ShadowingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("shadowing_sessions")
}

model GermanNoun {
  id          String   @id @default(cuid())
  word        String   @unique
  article     String
  translation String?
  createdAt   DateTime @default(now())

  @@map("german_nouns")
}

model VocabWord {
  id          String   @id @default(cuid())
  level       String
  headword    String
  german      String
  english     String
  source      String?
  createdAt   DateTime @default(now())

  @@map("vocab_words")
}
