{
  "name": "lingoraid-mobile",
  "version": "1.0.0",
  "description": "Application mobile React Native (Expo) pour LingoRaid",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start --max-workers 1",
    "start:clear": "expo start -c --max-workers 1",
    "android": "expo start --android --max-workers 1",
    "ios": "expo start --ios --max-workers 1",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.6.2",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-youtube-iframe": "^2.4.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.10"
  }
}
