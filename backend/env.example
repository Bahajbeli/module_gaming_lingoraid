# Configuration de la base de données (PostgreSQL)
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/lingoraid?schema=public"

# Configuration JWT
JWT_SECRET="changez-moi-en-production"

# Configuration Google OAuth
GOOGLE_CLIENT_ID="votre-google-client-id.apps.googleusercontent.com"

# Configuration du serveur
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"

# Configuration des uploads
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=2147483648
MAX_PAYLOAD_LIMIT=50mb

# IA – Ollama (optionnel, local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloudinary — images créativité (CDN, recommandé pour 1200+ jeux)
# Format : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@VOTRE_CLOUD_NAME
# ou séparément :
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_DELAY_MS=120

# IA – optionnel pour les mots (sinon banque croswords)
CREATIVITY_AI_PROVIDER=groq
CREATIVITY_USE_AI=false
CREATIVITY_AI_BATCH=2
CREATIVITY_AI_DELAY_MS=35000
GROQ_MODEL=llama-3.1-8b-instant

# IA – APIs (optionnel — laisser vide si non utilisé)
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
DEEPSEEK_API_KEY=
LONGCAT_API_KEY=

# Provider image créativité: pollinations | gemini | comfyui | local-svg
CREATIVITY_IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_MODEL=flux
